# kInorA — example environment file.
#
# Copy to `.env` at the repository root and fill in what you need. There is a
# single .env for the whole monorepo; the apps do not carry their own.
#
# Scope of this file: every variable that `docker-compose.yml` interpolates,
# plus the runtime knobs the API reads directly. Values shown after `=` are the
# effective defaults; empty means "no default, set it if you need the feature".
#
# THE COMPOSE FORWARDING RULE. Compose only injects variables listed under a
# service's `environment:` block. A variable that exists in this file and in the
# VPS .env but is missing from that block is silently ignored inside the
# container, which keeps the built-in default instead. This has shipped as a
# real bug more than once (STRIPE_*, VOICE_*, DEEPGRAM_*). When you add a
# variable here, add the matching forward in docker-compose.yml in the same
# change. The variables currently NOT forwarded are flagged inline below.
#
# Full reference with required/optional semantics: apps/api/README.md

# ─────────────────────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────────────────────

# Local PostgreSQL defaults used by docker-compose.yml.
# The checked-in Compose service uses pgvector/pgvector:pg17 so the vector
# migrations can execute CREATE EXTENSION vector without patching the SQL.
POSTGRES_DB=kinora
POSTGRES_USER=kinora
POSTGRES_PASSWORD=kinora
DATABASE_URL=postgres://kinora:kinora@localhost:5432/kinora

# ─────────────────────────────────────────────────────────────────────────────
# Compose and image metadata
# ─────────────────────────────────────────────────────────────────────────────

COMPOSE_PROJECT_NAME=kinora

# GHCR image settings used by CI/CD and VPS deployment.
GHCR_IMAGE=ghcr.io/<owner>/<repo>
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# Web origin and Google OAuth
# ─────────────────────────────────────────────────────────────────────────────

# Public origin of the web app (scheme + host, no trailing slash).
# The Google OAuth redirect URI is derived from this as <WEB_PUBLIC_ORIGIN>/callback/social.
# That derived URI must match what is registered in the Google Cloud Console.
# Set WEB_PUBLIC_ORIGIN to your real public domain in production.
WEB_PUBLIC_ORIGIN=https://kinora.aitsai.com

# Google OAuth (server-side OIDC client used by the API).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# OPTIONAL: explicit Google redirect URI override.
# Leave unset — the redirect URI is derived automatically as <WEB_PUBLIC_ORIGIN>/callback/social.
# Set only if the Google Console path differs from /callback/social.
# GOOGLE_REDIRECT_URI=https://kinora.aitsai.com/callback/social

# Web → API base URL used by the social-login proxy (server-side fetch).
# The api service publishes no ports; the web container reaches it over the
# Docker Compose network, so use the internal service hostname and port.
API_BASE_URL=http://api:4000

# ─────────────────────────────────────────────────────────────────────────────
# AI plan generation — OpenRouter (08-v1-ai-plan-generation)
# ─────────────────────────────────────────────────────────────────────────────

# Required in production, NOT needed for local unit tests — the test suite uses
# MockPlanGenerator and calls neither OpenRouter nor Langfuse.

# OpenRouter API key. Obtain at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenRouter model identifier (OpenRouter provider/model namespace).
# MUST be a model that supports JSON-schema structured output (e.g. openai/gpt-4o-mini).
# Models that only support function-calling fail at generation time.
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─────────────────────────────────────────────────────────────────────────────
# AI provider admin (09-ai-provider-admin)
# ─────────────────────────────────────────────────────────────────────────────

# The active provider is switched at runtime from /admin/ai-config. Only the key
# for the currently-selected provider needs to be set. These are operator-managed
# via the server .env — NOT stored in the DB and never shown in the UI.

# OpenAI — required when provider "openai" is selected. Also used by the default
# vector-memory embedding provider and by the default voice stack (see below).
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic — required only when provider "anthropic" is selected.
# Obtain at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Generative AI — required when provider "google" is selected, and by the
# Google/Gemini voice adapters.
# Obtain at: https://ai.google.dev/gemini-api/docs/api-key
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenCode-Go — required only when provider "opencode-go" is selected.
# Obtain at: https://opencode.ai
OPENCODE_GO_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Langfuse — prompt management and LLM observability (16e)
# ─────────────────────────────────────────────────────────────────────────────

# NO-OP when the keys are unset: absent or invalid credentials never fail a
# request. Plan generation and chat produce the same output either way, and a
# construction, emission or flush failure is reported as a single secret-free
# warn line.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Langfuse host. Use https://cloud.langfuse.com for Langfuse Cloud.
LANGFUSE_HOST=https://cloud.langfuse.com

# OPTIONAL, local dev only: SDK-conventional alias for the host.
# Precedence is LANGFUSE_BASEURL ?? LANGFUSE_HOST — when both are set this wins.
# Production sets only LANGFUSE_HOST, passed explicitly as baseUrl so the SDK
# never picks the value up implicitly from the environment.
# NOT forwarded in docker-compose.yml — it is a dev-only convenience.
# LANGFUSE_BASEURL=http://localhost:3001

# In-process cache TTL (ms) for the remote prompt provider. Default 60000 when
# unset, unparseable or non-positive — it never throws at startup.
# The three prompts (kinora-plan-generation, kinora-chat-reply,
# kinora-chat-extraction) are resolved at runtime from Langfuse under the fixed
# `production` label. A fetch failure, a missing prompt or a template that fails
# boundary validation falls back to the compiled-in local template, so a Langfuse
# outage never breaks generation. Every trace carries promptSource.
LANGFUSE_PROMPT_CACHE_TTL_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# Voice — STT and TTS provider selection (13-v1.1-interactive-voice-chat)
# ─────────────────────────────────────────────────────────────────────────────

# STT and TTS are chosen INDEPENDENTLY at deploy time, so a deployment can use
# Deepgram for transcription while keeping OpenAI for synthesis. This is an env
# decision, not a per-tenant runtime config, and it is not in the database.
#
# Fail-safe: an unknown or unset value falls back to `openai`, so a misconfigured
# environment can never leave voice with no adapter.

# One of: openai | google | deepgram. Default openai.
#   google   → Gemini STT (GOOGLE_GENERATIVE_AI_API_KEY)
#   deepgram → Deepgram Listen (DEEPGRAM_API_KEY)
VOICE_STT_PROVIDER=openai

# One of: openai | google | deepgram. Default openai.
#   google   → Gemini TTS, returns audio/wav
#   deepgram → Deepgram Aura-2, returns container-wrapped audio/wav
# Setting both VOICE_* to google or deepgram gives a fully OpenAI-free voice stack.
VOICE_TTS_PROVIDER=openai

# Deepgram API key — required when either VOICE_* provider is `deepgram`.
# Without it the adapters fall back to a placeholder key and every live call fails.
# Obtain at: https://console.deepgram.com
DEEPGRAM_API_KEY=

# Deepgram tuning. Defaults match the adapters, so behaviour is unchanged unless
# you override them.
DEEPGRAM_STT_MODEL=nova-2
DEEPGRAM_STT_LANGUAGE=es
DEEPGRAM_TTS_MODEL=aura-2-carina-es

# Google/Gemini voice tuning. Defaults match the adapters.
GOOGLE_STT_MODEL=gemini-2.5-flash
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
GOOGLE_TTS_VOICE=Kore

# GOOGLE_TTS_STYLE_DIRECTIVE — leave this commented out.
#
# The synthesizer resolves it with `?? DEFAULT_TTS_STYLE_DIRECTIVE`, and an empty
# assignment is an empty string, not an absent value. Uncommenting it without a
# value would replace the Castilian-accent directive with "" instead of falling
# back to the default. For the same reason it is deliberately NOT forwarded in
# docker-compose.yml, so it is not overridable inside a container today. Making
# it overridable requires the adapter to treat an empty value as unset first.
# GOOGLE_TTS_STYLE_DIRECTIVE=

# ─────────────────────────────────────────────────────────────────────────────
# Vector memory (10b-user-memory-vector)
# ─────────────────────────────────────────────────────────────────────────────

# These values define the embedding cohort persisted in pgvector. Keep them
# stable per environment. Changing the model, version or dimension without a
# coordinated re-embed creates an incompatible cohort that retrieval will
# intentionally skip — data is not lost, it just stops being returned.
VECTOR_MEMORY_EMBEDDING_PROVIDER=openai
VECTOR_MEMORY_EMBEDDING_MODEL=text-embedding-3-small
VECTOR_MEMORY_EMBEDDING_VERSION=text-embedding-3-small
VECTOR_MEMORY_EMBEDDING_DIMENSION=1536
VECTOR_MEMORY_EMBEDDING_TIMEOUT_MS=3000
VECTOR_MEMORY_EMBEDDING_MAX_ATTEMPTS=2

# Rollback boundary: to disable confirmed-memory writes and retrieval without
# taking the API down, unset OPENAI_API_KEY so the embedding boundary fails open
# while the rest of plan generation keeps working. Do NOT remove
# CREATE EXTENSION vector from the migration and do NOT swap the Postgres image
# back to a plain postgres:* image.

# ─────────────────────────────────────────────────────────────────────────────
# Billing — Stripe (11b-v1-billing-stripe-integration)
# ─────────────────────────────────────────────────────────────────────────────

# Without these the Stripe gateway is unconfigured and the whole billing flow
# (checkout, portal, webhook) fails closed. `pnpm dev` reads this file directly,
# so a missing forward in docker-compose.yml only bites inside Docker.

# Use test-mode keys for development.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price ids for the Pro tier.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# Display amounts, in minor units of STRIPE_PRICE_CURRENCY. They drive the
# pricing copy and the annual save badge; they do not charge anything by
# themselves — the Price id is what Stripe bills.
STRIPE_PRICE_MONTHLY_AMOUNT=
STRIPE_PRICE_ANNUAL_AMOUNT=

# ISO-4217 code, lowercased at read time. Default eur.
STRIPE_PRICE_CURRENCY=eur

# ─────────────────────────────────────────────────────────────────────────────
# Seat billing — Trainer tier (16c-v3-b2b-seat-billing)
# ─────────────────────────────────────────────────────────────────────────────

# Per-seat Stripe Price ids for the Trainer tier.
STRIPE_PRICE_TRAINER_SEAT_MONTHLY=
STRIPE_PRICE_TRAINER_SEAT_ANNUAL=

# Off by default. Set to 1 to activate the outbound Stripe seat-quantity sync.
SEAT_BILLING_ENABLED=0

# ─────────────────────────────────────────────────────────────────────────────
# Production deployment assumptions
# ─────────────────────────────────────────────────────────────────────────────

# - Configure GitHub secrets: VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_KNOWN_HOSTS,
#   optional VPS_PORT, optional VPS_DEPLOY_DIR, and PRODUCTION_BASE_URL.
# - VPS_KNOWN_HOSTS must contain the base64-encoded (or literal) ssh-keyscan output
#   for the VPS host (pinned host key fingerprint). The deploy workflow uses this
#   instead of ssh-keyscan to avoid trust-on-first-use.
# - The VPS deployment directory contains this repository plus a production .env.
#   That operator .env holds the runtime secrets (OPENROUTER_*, LANGFUSE_*,
#   DEEPGRAM_*, STRIPE_*, optional POSTGRES_*), is never shipped by CI, and
#   survives across deploys.
# - Deploy-managed vars (GHCR_IMAGE, IMAGE_TAG, GOOGLE_*, API_BASE_URL,
#   WEB_PUBLIC_ORIGIN) are restored from the pipeline payload after the operator
#   .env is sourced, so a stale value left on the server can never make a green
#   deploy run an old image. Do not pin them in the operator .env.
# - The VPS has Docker, Docker Compose, Node.js 24+, and pnpm 10.17.1 available.
# - PostgreSQL data stays in the Docker Compose volume named postgres-data.
